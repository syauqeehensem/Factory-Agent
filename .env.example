# =============================================================================
# Factory Agent — environment configuration
# =============================================================================
# Copy this file to ".env" and add your key. The agents need an LLM to run.
#
#   cp .env.example .env       (macOS/Linux)
#   copy .env.example .env     (Windows)
#
# You can reuse the same OpenAI key as the other AIMP kits.

# --- LLM ---------------------------------------------------------------------
OPENAI_API_KEY=

# gpt-4o-mini is cheap, fast, and good at tool-calling — ideal for this demo.
# Upgrade to gpt-4o for tougher reasoning.
CHAT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=0

# Low temperature keeps orchestration decisions predictable.
TEMPERATURE=0.1

# --- Orchestration -----------------------------------------------------------
# Safety net for the cyclic graph: max super-steps before LangGraph stops.
RECURSION_LIMIT=18

# --- Secure tool-calling guardrail -------------------------------------------
# Purchase orders at or below this auto-approve; above needs supervisor sign-off.
# Lower it (e.g. 500) to watch the guardrail block a parts order in the demo.
AUTO_APPROVE_LIMIT=1000

# --- Project data -----------------------------------------------------------
# Root folder for all external project files.
PROJECT_DATA_DIR=Project Data

# Status and ticket CSV paths used by deterministic line/ticket tools.
STATUS_CSV_PATH=Project Data/status.csv
MTP_CSV_PATH=Project Data/mtp.csv

# Yield CSV path used by yield analysis tools.
YIELD_CSV_PATH=Project Data/Yield/Yield data by tools.csv

# --- Branding ---------------------------------------------------------------
APP_TITLE=TCB Chatbot
FOUNDRY_LOGO_PATH=assets/foundry-logo.svg
