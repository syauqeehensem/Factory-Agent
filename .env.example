# =============================================================================
# Factory Agent — environment configuration
# =============================================================================
# Copy this file to ".env" and add your key. The agents need an LLM to run.
#
#   cp .env.example .env       (macOS/Linux)
#   copy .env.example .env     (Windows)
#
# You can reuse the same OpenAI key as the other AIMP kits.

# --- LLM ---------------------------------------------------------------------
OPENAI_API_KEY=

# gpt-4o-mini is cheap, fast, and good at tool-calling — ideal for this demo.
# Upgrade to gpt-4o for tougher reasoning.
CHAT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=0
PROMPT_STYLE=base

# Low temperature keeps orchestration decisions predictable.
TEMPERATURE=0.1

# --- Orchestration -----------------------------------------------------------
# Safety net for the graph: max super-steps before LangGraph stops.
RECURSION_LIMIT=18

# --- Data (real data lives under data/) --------------------------------------
# Root folder for the status/ticket/yield CSVs and technician PDFs.
DATA_DIR=data

# Status and ticket CSV paths used by the status check and technician agent.
STATUS_CSV_PATH=data/status.csv
MTP_CSV_PATH=data/mtp.csv
TECHNICIAN_DOCS_DIR=data

# Per-entity yield CSV (columns: entity,yield) used by the yield agent.
YIELD_CSV_PATH=data/yield.csv
MANUAL_TOP_K=3
MANUAL_STATUS_LAZY=1
MANUAL_MAX_PDF_PAGES=60
MANUAL_MAX_CHUNKS_PER_FILE=180
RAG_TOP_K=6
RAG_MANUAL_MAX_CHUNKS=500

# Yield goal: tools at/above this percent pass; below triggers escalation.
YIELD_THRESHOLD=50

# --- Branding ---------------------------------------------------------------
APP_TITLE=TCB Chatbot
FOUNDRY_LOGO_PATH=assets/foundry-logo.svg
